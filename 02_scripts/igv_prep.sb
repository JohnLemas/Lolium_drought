#!/bin/bash --login
#SBATCH --job-name=IGV_prep
#SBATCH --cpus-per-task=8
#SBATCH --mem=8G
#SBATCH --time=01:30:00
#SBATCH --output=/mnt/scratch/lemasjoh/Lolium_RNAseq/logs/%x-%j.out

set -euo pipefail

# 1. Paths (mirrors run_featureCounts.sh)
BASE="/mnt/scratch/lemasjoh/Lolium_RNAseq"
DATA_DIR="${BASE}/03_outputs/02_STAR"
OUT_DIR="${BASE}/03_outputs/03_featureCounts"
IGV_DIR="${OUT_DIR}/igv_bams"
METADATA="${BASE}/01_inputs/Lol_metadata.txt"
THREADS=8

mkdir -p "$IGV_DIR"

ml purge
ml load SAMtools

# 2. Build ordered sample list from metadata (same parsing as run_featureCounts.sh)
SAMPLES=()
while IFS= read -r sample; do
    SAMPLES+=("$sample")
done < <(awk -F'\t' '{print $2}' "$METADATA")

echo "Samples to process for IGV:"
printf '  %s\n' "${SAMPLES[@]}"

# 3. For each sample: sort + index the featureCounts per-read BAM,
#    then split into Assigned / Unassigned_NoFeatures tracks for easy
#    visual comparison of read pileup against annotated 3' ends in IGV.
for sample in "${SAMPLES[@]}"; do
    raw_bam="${OUT_DIR}/${sample}_Aligned.sortedByCoord.out.bam.featureCounts.bam"

    if [[ ! -f "$raw_bam" ]]; then
        echo "ERROR: featureCounts BAM not found for sample '${sample}': ${raw_bam}" >&2
        exit 1
    fi

    sorted_bam="${IGV_DIR}/${sample}.featureCounts.sorted.bam"
    assigned_bam="${IGV_DIR}/${sample}.assigned.bam"
    unassigned_bam="${IGV_DIR}/${sample}.unassigned_nofeature.bam"

    echo "[$sample] Sorting..."
    samtools sort -@ "$THREADS" -o "$sorted_bam" "$raw_bam"
    samtools index "$sorted_bam"

    echo "[$sample] Splitting by assignment status..."
    samtools view -d XS:Assigned -b "$sorted_bam" > "$assigned_bam"
    samtools index "$assigned_bam"

    samtools view -d XS:Unassigned_NoFeatures -b "$sorted_bam" > "$unassigned_bam"
    samtools index "$unassigned_bam"

    echo "[$sample] Done -> $sorted_bam, $assigned_bam, $unassigned_bam"
done

echo "All samples processed. Load the .sorted.bam (or the assigned/unassigned splits) into IGV from ${IGV_DIR}"