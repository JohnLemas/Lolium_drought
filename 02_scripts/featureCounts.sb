#!/bin/bash --login
#SBATCH --job-name=Counts
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --output=/mnt/scratch/lemasjoh/Lolium_RNAseq/logs/%x-%j.out

set -euo pipefail

# 1. Paths
BASE="/mnt/scratch/lemasjoh/Lolium_RNAseq"
DATA_DIR="${BASE}/03_outputs/02_STAR"
ANN="${BASE}/01_inputs/LolRi_v01.0.gtf"
OUT_DIR="${BASE}/03_outputs/03_featureCounts"
METADATA="${BASE}/01_inputs/Lol_metadata.txt"

mkdir -p "$OUT_DIR"

# 2. Clean up any prior featureCounts outputs so this is a fresh run
#    (featureCounts -R BAM writes <input_bam>.featureCounts.bam next to the input BAM in DATA_DIR)
echo "Removing old featureCounts BAM/BAI outputs from ${DATA_DIR}..."
find "$DATA_DIR" -maxdepth 1 -name "*.featureCounts.bam*" -print -delete

echo "Removing old count tables from ${OUT_DIR}..."
rm -f "${OUT_DIR}/counts.txt" "${OUT_DIR}/counts.txt.summary" "${OUT_DIR}/counts.txt.jcounts"

# 3. Build ordered BAM list from metadata
#    Tab-delimited file, sample name in column 2, no header row skipped
BAM_LIST=()
while IFS= read -r sample; do
    bam="${DATA_DIR}/${sample}_Aligned.sortedByCoord.out.bam"
    if [[ ! -f "$bam" ]]; then
        echo "ERROR: BAM not found for sample '${sample}': ${bam}" >&2
        exit 1
    fi
    BAM_LIST+=("$bam")
done < <(awk -F'\t' '{print $2}' "$METADATA")

echo "Sample order passed to featureCounts:"
printf '  %s\n' "${BAM_LIST[@]}"

ml purge
ml load Subread

# 4. Run featureCounts
featureCounts -T 8 \
    -s 1 \
    -a "${ANN}" \
    -t exon \
    -g gene_id \
    -M --fraction \
    --largestOverlap \
    --readExtension3 200 \
    -R BAM \
    -o "${OUT_DIR}/counts.txt" \
    "${BAM_LIST[@]}"

echo "Done. Per-read assignment BAMs written to ${DATA_DIR}/*.featureCounts.bam (unsorted - see process_igv_bams.sh)."